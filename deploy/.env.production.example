# ============================================================
# .env.production — נכתב אוטומטית ע"י deploy/setup-selfhost.sh
# הקובץ הזה הוא תבנית לעיון בלבד. הסודות נמצאים ב:
#   /root/kobi-supabase/docker/.env  (מפתחות הסטאק המקומי)
#   /root/kobi-git/.env.production   (נוצר ע"י הסקריפט, בהתאם למיקום השכפול שלך)
# ⚠️ לא לדחוף סודות ל-git!
# ============================================================

# --- Supabase self-hosted מקומי (Kong על 127.0.0.1:8300) ---
SUPABASE_URL="https://api-kobi.nuri1.fit"
SUPABASE_PUBLISHABLE_KEY="<ANON_KEY מהסטאק המקומי>"
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY מהסטאק המקומי>"

# --- מיילי הזמנה (Resend) — אופציונלי אך מומלץ ---
# ריק = ההזמנות נקלטות כרגיל אך המיילים לא יישלחו.
# כתובת ה"מאת" בפועל ורשימת המנהלים המקבלים התראה מוגדרות בפאנל
# הניהול באתר (הגדרות מייל), לא כאן — כאן רק המפתח לשליחה עצמה.
RESEND_API_KEY=""
