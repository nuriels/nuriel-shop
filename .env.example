# ============================================================
# משתני סביבה — לפריסה מקומית: cp .env.example .env
# ב-Coolify: מגדירים אותם במסך Environment Variables של האפליקציה
# (Coolify מזהה אותם אוטומטית מ-docker-compose.yml).
# ⚠️ לא לדחוף .env אמיתי ל-git!
# ============================================================

# --- Supabase ---
# כתובת ה-API (Kong) של Supabase — למשל https://api.example.com
SUPABASE_URL=
# anon / publishable key — ציבורי, נאפה גם לבאנדל הדפדפן
SUPABASE_PUBLISHABLE_KEY=
# service_role key — סודי! עוקף RLS, נשאר בצד השרת בלבד
SUPABASE_SERVICE_ROLE_KEY=

# --- מיילים (Resend) — מפתח אחד לכל החנויות ---
RESEND_API_KEY=
# השולח: "שם החנות <הכתובת הזו>" — דומיין מאומת ב-Resend (ריק = orders@<TENANT_BASE_DOMAIN>)
EMAIL_FROM_ADDRESS=
# סוד לחתימת קודי כניסה למייל (ריק = נגזר מ-SUPABASE_SERVICE_ROLE_KEY)
LOGIN_CODE_SECRET=

# --- כתובות החנויות (לקישורים במיילים) ---
# כתובת חנות ברירת המחדל, למשל https://kobi.example.com
PUBLIC_SITE_URL=
# דומיין בסיס לחנויות בתת-דומיין (shop2.example.com ← example.com).
# חנות עם דומיין משלה מוגדרת בעמודה tenants.domain.
TENANT_BASE_DOMAIN=

# --- פאנל ניהול הפלטפורמה ---
# בדומיין הזה מוצג רק /platform (הקמת חנויות וכו'); הוא לא משמש כחנות
PLATFORM_ADMIN_HOST=
