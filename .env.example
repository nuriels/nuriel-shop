# ============================================================
# משתני סביבה — לפריסה מקומית: cp .env.example .env
# ב-Coolify: מגדירים אותם במסך Environment Variables של האפליקציה
# (Coolify מזהה אותם אוטומטית מ-docker-compose.yml).
# ⚠️ לא לדחוף .env אמיתי ל-git!
# ============================================================

# --- Supabase ---
# כתובת ה-API (Kong) של Supabase — למשל https://api.example.com
SUPABASE_URL=
# anon / publishable key — ציבורי, נאפה גם לבאנדל הדפדפן
SUPABASE_PUBLISHABLE_KEY=
# service_role key — סודי! עוקף RLS, נשאר בצד השרת בלבד
SUPABASE_SERVICE_ROLE_KEY=

# --- מיילים (Resend) — מפתח אחד לכל החנויות ---
RESEND_API_KEY=
# סליקה דרך Grow (חלק 43): מפתח הצפנה (openssl rand -base64 32) — לשמור גיבוי נפרד!
GROW_SECRETS_KEY=
# כתובת ה-API של Grow בייצור (נמסרת ע"י Grow)
GROW_API_URL=
# השולח: "שם החנות <הכתובת הזו>" — דומיין מאומת ב-Resend (ריק = orders@<TENANT_BASE_DOMAIN>)
EMAIL_FROM_ADDRESS=
# סוד לחתימת קודי כניסה למייל, קודי/טוקני הפורטל וה-CAPTCHA (openssl rand -hex 32).
# ריק = מפתח השירות משמש כמפתח HMAC — לא מומלץ (SEC-L13); setup-selfhost.sh יוצר ושומר אותו
LOGIN_CODE_SECRET=
# שליחת רישיונות דיגיטליים (פיילוט): מפתח הצפנת מפתחות הרישיון במסד (openssl rand -hex 32, לפחות 32 תווים).
# ריק = המודול לא שומר ולא שולח רישיונות. אסור להחליף אחרי שנשמרו מפתחות — הם מוצפנים בו. לגבות!
# setup-selfhost.sh יוצר ושומר אותו
LICENSE_KEYS_SECRET=

# --- דומיינים מותאמים של חנויות ---
# כתובות ה-IP של השרת (מופרדות בפסיק) לבדיקת רשומת A. ריק = הכתובת של <slug>.<TENANT_BASE_DOMAIN>
SERVER_PUBLIC_IPS=

# --- כתובות החנויות (לקישורים במיילים) ---
# כתובת חנות ברירת המחדל, למשל https://kobi.example.com
PUBLIC_SITE_URL=
# דומיין בסיס לחנויות בתת-דומיין (shop2.example.com ← example.com).
# חנות עם דומיין משלה מוגדרת בעמודה tenants.domain.
TENANT_BASE_DOMAIN=

# --- פאנל ניהול הפלטפורמה ---
# בדומיין הזה מוצג רק /platform (הקמת חנויות וכו'); הוא לא משמש כחנות
PLATFORM_ADMIN_HOST=

# --- Hospitality (מנוע האירוח) — docs/hospitality/install-guide.md §5 ---
# המתג הכללי: רק "on" מפעיל. ריק = כבוי
HOSPITALITY_ENGINE=
# סוד HMAC להגבלת הקצב ולאתגרי ה-CAPTCHA (openssl rand -hex 32) — זהה בכל השרתים.
# ריק = נגזר מ-LOGIN_CODE_SECRET / ממפתח השירות
HOSPITALITY_SECRET=
# קושי אתגר ה-CAPTCHA (לא חובה; 1000–2000000, ברירת מחדל 50000)
HOSPITALITY_POW_MAX=
