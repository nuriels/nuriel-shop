\set cid random(1, 50)
BEGIN;
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claims', json_build_object('sub', md5('t1-cust-' || :cid)::uuid, 'role', 'authenticated')::text, true), set_config('request.headers', '{"x-tenant-id":"71000000-0000-0000-0000-000000000001"}', true);
WITH pgrst_source AS (SELECT o."id", o."customer_id", o."agent_id", o."order_number", o."status", o."kind", o."total", o."note", o."vat_rate", o."prices_include_vat", o."created_at", o."tracking_number", o."shipping_provider", o."tracking_url", o."tracking_updated_at", o."delivery_attempts", o."last_delivery_failure_note", o."last_delivery_failure_at", o."shipped_at", o."delivered_at", o."payment_method", o."payment_status", o."paid_at", o."order_source", o."pos_payment_method", o."created_by_staff_id", o."bit_transaction_id", o."bit_receipt_url", o."payment_reported_at", o."payment_due_at", o."grow_asmachta", o."grow_transaction_id", o."grow_card", o."grow_installments", o."customer_name", o."customer_tax_id", o."customer_phone", o."customer_email", o."billing_city", o."billing_address", o."billing_zip", o."ship_to_different", o."shipping_name", o."shipping_phone", o."shipping_city", o."shipping_address", o."shipping_zip", o."shipping_method_id", o."shipping_method_name", o."shipping_kind", o."shipping_base_price", o."shipping_free_threshold", o."shipping_price", o."coupon_code", o."coupon_discount_type", o."coupon_discount_value", o."coupon_min_order", o."coupon_exclude_sale", o."discount_amount", o."manual_discount_type", o."manual_discount_value", o."manual_discount_amount", COALESCE(oi.j, '[]') AS "order_items" FROM public.orders o LEFT JOIN LATERAL (SELECT json_agg(oi_1) AS j FROM (SELECT i."id", i."product_id", i."quantity", i."unit_price", i."product_name", i."product_sku", i."product_barcode", i."product_image_url", i."is_deposit", i."is_gift", i."on_sale", i."is_digital", i."item_status", i."digital_license_key", i."license_sent_at", i."license_sent_to", i."variant_label", i."serial_number", i."warranty_until", i."serial_required" FROM public.order_items i WHERE i.order_id = o.id) oi_1) oi ON TRUE WHERE o.customer_id = (md5('t1-cust-' || :cid)::uuid)::text::uuid ORDER BY o.created_at DESC LIMIT 1000) SELECT null::bigint AS total_result_set, pg_catalog.count(_postgrest_t) AS page_total, coalesce(json_agg(_postgrest_t), '[]')::character varying AS body FROM (SELECT * FROM pgrst_source) _postgrest_t;
COMMIT;
